<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\IBussinesLogic\IBussinesLogic.csproj" />
    <ProjectReference Include="..\Repository\Repository.csproj" />
    <ProjectReference Include="..\ServiceFactory\ServiceFactory.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Properties\launchSettings.json" />
  </ItemGroup>

  <Target Name="BuildPlugins" BeforeTargets="Build;Publish">
  <MSBuild Projects="..\..\JsonImporter\JsonImporter\JsonImporter.csproj"
           Targets="Restore;Build"
           Properties="Configuration=$(Configuration)" />

  <MSBuild Projects="..\..\XmlImporter\XmlImporter\XmlImporter.csproj"
           Targets="Restore;Build"
           Properties="Configuration=$(Configuration)" />
</Target>

<Target Name="CopyPluginsToBuild" AfterTargets="Build">
  <ItemGroup>
    <PluginFiles Include="..\..\JsonImporter\JsonImporter\bin\$(Configuration)\net8.0\JsonImporter.dll" />
    <PluginFiles Include="..\..\XmlImporter\XmlImporter\bin\$(Configuration)\net8.0\XmlImporter.dll" />
    <PluginFiles Include="..\IImporters\bin\$(Configuration)\net8.0\IImporters.dll" />
  </ItemGroup>

  <MakeDir Directories="$(OutputPath)Plugins" />

  <Copy
    SourceFiles="@(PluginFiles)"
    DestinationFolder="$(OutputPath)Plugins"
    SkipUnchangedFiles="true" />
</Target>

<Target Name="CopyPluginsToPublish" AfterTargets="Publish">
  <ItemGroup>
    <PluginFiles Include="..\..\JsonImporter\JsonImporter\bin\$(Configuration)\net8.0\JsonImporter.dll" />
    <PluginFiles Include="..\..\XmlImporter\XmlImporter\bin\$(Configuration)\net8.0\XmlImporter.dll" />
    <PluginFiles Include="..\IImporters\bin\$(Configuration)\net8.0\IImporters.dll" />
  </ItemGroup>

  <MakeDir Directories="$(PublishDir)Plugins" />

  <Copy
    SourceFiles="@(PluginFiles)"
    DestinationFolder="$(PublishDir)Plugins"
    SkipUnchangedFiles="true" />
</Target>

  <ItemGroup>
    <Content Update="appsettings.json">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>

    <Content Update="appsettings.Development.json">
      <DependentUpon>appsettings.json</DependentUpon>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>